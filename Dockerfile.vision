FROM python:3.11-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app HF_HOME=/var/data/huggingface TORCH_HOME=/var/data/torch EASYOCR_MODULE_PATH=/var/data/easyocr
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 libgl1 libglib2.0-0 libzbar0 && rm -rf /var/lib/apt/lists/*
COPY vision_pipeline/requirements-render.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch torchvision && pip install --no-cache-dir -r /tmp/requirements.txt && pip check
COPY vision_pipeline /app
CMD ["sh", "-c", "exec python -X faulthandler -m uvicorn api.app:app --host 0.0.0.0 --port ${PORT:-10000} --workers 1"]
